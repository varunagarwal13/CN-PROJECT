# Core Application Config
NETMIRAGE_ENV=development
DATABASE_URL=sqlite:///./netmirage.db
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety Policy Guardrails
ALLOWED_LAB_CIDRS=10.0.10.0/24,10.0.20.0/24,10.0.30.0/24,10.0.40.0/24,10.0.50.0/24
ALLOWED_LAB_PORTS=22,2222,53,80,8080,25,587
MAX_ACTIONS_PER_MINUTE=30
MAX_CONCURRENT_ACTIONS=2
MAX_RUN_DURATION_SECONDS=600

# AI Planner Configuration (Uses Deterministic State-Machine if API Key is empty)
PLANNER_MODE=deterministic_or_llm
GEMINI_API_KEY=
OPENAI_API_KEY=
